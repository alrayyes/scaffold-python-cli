{
  "name": "scaffold-python-cli-tooling",
  "private": true,
  "description": "Not a JavaScript project. This exists so commitlint can resolve the shared config it extends, which bunx alone cannot do, and so Prettier and markdownlint are pinned like everything else.",
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "lefthook": "2.1.14",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.8"
  },
  "trustedDependencies": ["lefthook"],
  "scripts": {
    "prepare": "lefthook install",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:md": "markdownlint-cli2",
    "lint:prose": "./scripts/lint-prose.sh",
    "lint:mechanics": "./scripts/lint-mechanics.sh"
  }
}
